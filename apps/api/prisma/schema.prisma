// DSA Tracker — production schema.
//
// Design notes that matter for correctness:
//
//  * Day bucketing is stored as a `dayKey` string (`YYYY-MM-DD`) in the *program*
//    timezone, never as a timestamp. Storing a DATE would re-introduce the server's
//    timezone into every comparison; the string is unambiguous and indexes well.
//
//  * `Submission` is a permanent local mirror of every submission we ever observe.
//    LeetCode's `recentAcSubmissionList` returns at most 20 rows, so history outside
//    that window is unrecoverable from the API. We never re-derive history — we append
//    to the mirror and recompute everything downstream from it.
//
//  * Every aggregate (`DailyStatus`, leaderboards, achievements) is a *cache* that can
//    be rebuilt from `Submission` + `Assignment` + `ScoringConfig`. That is what makes
//    "recalculate scores" and admin-editable formulas safe to run at any time.
//
//  * Idempotency: unique constraints on (student, providerSubmissionId) and
//    (student, dayKey) mean a sync can be re-run any number of times without
//    double-counting.

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native"]
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — values mirror the string unions in @dsa/shared exactly.
// ---------------------------------------------------------------------------

/// `STUDENT` is a login identity, not a new data model — it is deliberately the only
/// role tied to a `Student` row (`User.studentId`). Authorization defaults flip for it:
/// every other role is implicitly allowed on a route with no `@Roles(...)`, but
/// `RolesGuard` denies `STUDENT` by default there instead, so a route that forgets to
/// exclude students fails closed rather than open.
enum UserRole {
  ADMIN
  MENTOR
  VIEWER
  STUDENT
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProblemStatus {
  ACCEPTED
  ATTEMPTED_NOT_ACCEPTED
  NOT_ATTEMPTED
  UNKNOWN
}

/// `ARCHIVED` means "no longer in the current program" — the state a student reaches
/// when they fall off the authoritative roster. It is deliberately *not* a delete:
/// their submissions, daily statuses, streak history, leaderboard entries and email
/// history all remain, because those are historical facts that stay true after someone
/// leaves. Every "current" surface (active counts, dashboard, daily tracker,
/// leaderboards, new assignments, daily emails) filters archived students out; every
/// historical surface keeps them.
enum StudentStatus {
  ACTIVE
  INACTIVE
  DROPPED
  PAUSED
  ARCHIVED
}

/// Lifecycle of a batch itself, independent of whether students are in it. An archived
/// batch stops appearing in pickers and current statistics but keeps owning its
/// historical assignments and daily statuses.
enum BatchStatus {
  ACTIVE
  ARCHIVED
}

/// Lifecycle of a campus. Mirrors `BatchStatus` deliberately: an archived campus stops
/// appearing in pickers, "all campuses" aggregates and new assignment targets, but keeps
/// owning every student, batch, assignment and result it ever had. A campus is never
/// deleted — doing so would orphan years of history.
enum CampusStatus {
  ACTIVE
  ARCHIVED
}

/// What caused a `StudentBatchHistory` or `StudentCampusHistory` row. Distinguishes a
/// mentor's deliberate move from the roster loader's initial placement, which matters
/// when auditing why a student's batch or campus changed.
enum BatchChangeSource {
  MANUAL
  ROSTER_SYNC
  IMPORT
  MIGRATION
}

/// Why a student's data looks the way it does. Distinguishes "genuinely solved
/// nothing" from "we could not read this profile" — a distinction mentors need.
enum SyncStatus {
  OK
  /// On the roster, but no LeetCode handle has been collected yet — the sync never
  /// attempts these students. Distinct from NEVER_SYNCED, which is a student who has a
  /// handle the sync has not reached yet. See the note in `@dsa/shared`.
  PROFILE_MISSING
  NEVER_SYNCED
  USER_NOT_FOUND
  PROFILE_PRIVATE
  RATE_LIMITED
  PROVIDER_ERROR
  TIMEOUT
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum SyncTrigger {
  MANUAL
  CRON
  RETRY
  IMPORT
  API
}

enum SyncMode {
  FULL
  INCREMENTAL
  RETRY_FAILED
  SINGLE_STUDENT
}

enum LeaderboardPeriod {
  DAILY
  WEEKLY
  MONTHLY
  ALL_TIME
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum NotificationChannel {
  EMAIL
  SLACK
  DISCORD
  WHATSAPP
  TELEGRAM
}

enum NotificationEvent {
  ASSIGNMENT_MISSED
  STREAK_BROKEN
  LEADERBOARD_UPDATED
  SYNC_COMPLETED
  SYNC_FAILED
  ACHIEVEMENT_UNLOCKED
  DAILY_REPORT_PENDING_APPROVAL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Why a student did not finish the day's assignment — recorded by a mentor, never
/// inferred. A solved-count of 1 with no `Blocker` row is reported as "no blocker
/// reported", not silently treated as `NO_BLOCKER`; the two are different facts.
enum BlockerCategory {
  CONCEPTUAL_DIFFICULTY
  UNABLE_TO_UNDERSTAND_PROBLEM
  UNABLE_TO_IDENTIFY_PATTERN
  CODING_IMPLEMENTATION_ISSUE
  ENVIRONMENT_SETUP_ISSUE
  LEETCODE_ISSUE
  TIME_MANAGEMENT
  INTERNET_DEVICE_ISSUE
  PERSONAL_REASON
  NO_BLOCKER
  OTHER
}

/// Lifecycle of one generated daily report email:
/// DRAFT → PENDING_APPROVAL → APPROVED → SENDING → SENT, or SENDING → FAILED.
///
/// `SENDING` is the in-flight claim. It exists so a send can never be started twice: the
/// transition APPROVED → SENDING is a conditional UPDATE, and only the request that wins
/// it calls the provider. It also distinguishes "crashed mid-send, delivery unknown"
/// from "never attempted", which a straight APPROVED → SENT jump cannot.
///
/// `SENT` is terminal — it is written only after the provider has accepted the message
/// and returned an id, never optimistically.
enum EmailReportStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENDING
  SENT
  FAILED
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  passwordHash      String
  name              String
  role              UserRole  @default(MENTOR)
  avatarUrl         String?
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  /// When the password was last changed — distinct from `updatedAt`, which also moves on
  /// unrelated edits (name, role). Drives "force a password change" for a student's first
  /// login, without needing a separate boolean that could drift out of sync.
  passwordChangedAt DateTime?

  /// Set only for `role = STUDENT`: which `Student` row this login belongs to. Nullable
  /// and unique — nullable because every non-student `User` has no student to point at;
  /// unique because a student has at most one login, never two accounts sharing history.
  /// This is the *entire* link between the login system and the academic data; nothing
  /// about batch, cohort, belt, streak or submissions is ever duplicated onto `User` (§2).
  studentId String? @unique @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student                   Student?                   @relation(fields: [studentId], references: [id], onDelete: SetNull)
  mentoredSquads            Squad[]                    @relation("SquadMentor")
  mentorCampuses            MentorCampus[]
  assignments               Assignment[]               @relation("AssignmentAuthor")
  notes                     MentorNote[]
  auditLogs                 AuditLog[]
  refreshTokens             RefreshToken[]
  adminPasswordResetTokens  AdminPasswordResetToken[]
  apiKeys                   ApiKey[]
  syncJobs                  SyncJob[]
  blockersRecorded          Blocker[]                  @relation("BlockerRecordedBy")
  emailReportsGenerated     EmailReport[]              @relation("EmailReportGeneratedBy")
  emailReportsApproved      EmailReport[]              @relation("EmailReportApprovedBy")
  batchChanges              StudentBatchHistory[]      @relation("BatchChangedBy")
  campusChanges             StudentCampusHistory[]     @relation("CampusChangedBy")
  baselineTestsCreated      BaselineTest[]             @relation("BaselineTestAuthor")
  baselineAttemptsReviewed  BaselineTestAttempt[]      @relation("BaselineAttemptReviewer")
  assignmentAudienceChanges AssignmentAudienceChange[] @relation("AssignmentAudienceChangedBy")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

/// Refresh tokens are persisted (hashed) so that logout and "revoke all sessions"
/// are real operations rather than client-side gestures.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Single-use, short-lived tokens for the admin email-recovery path (`AdminRecoveryService`).
/// Hashed at rest and shaped like `RefreshToken`, for the same reason: a real revoke/expire
/// is a DB operation, not a client-side gesture, and the plaintext token is never stored.
model AdminPasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_password_reset_tokens")
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  /// Only the hash is stored; the plaintext key is shown once at creation.
  keyHash     String    @unique
  prefix      String
  scopes      String[]  @default([])
  createdById String?   @db.Uuid
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([prefix])
  @@map("api_keys")
}

// ---------------------------------------------------------------------------
// Campus, cohort structure
// ---------------------------------------------------------------------------

/// A campus is the outermost organisational unit: `Campus → Batch → Student`.
///
/// It exists as a table rather than a string column on `Student` for the same reason
/// `Batch` does: campuses own things. A campus owns its batches (VELS/Foundation and
/// SRM/Foundation are *different* groups, not one shared batch), it scopes assignments
/// and baseline tests, and it is the unit every filter, leaderboard and report can be
/// narrowed to. Nothing below this model hard-codes a campus name or code — adding a
/// third campus is a row in this table plus a batch row per level.
///
/// `code` is the short stable key used in URLs and filter chips (`VELS`, `SRM`), stored
/// uppercase and compared case-insensitively at the edges.
model Campus {
  id          String       @id @default(uuid()) @db.Uuid
  /// Full institutional name, e.g. "Vels Institute of Science, Technology & Advanced Studies".
  name        String       @unique
  /// Short stable key used in URLs, filters and imports, e.g. "VELS".
  code        String       @unique
  description String?
  status      CampusStatus @default(ACTIVE)
  /// Display order for pickers and reports, so the founding campus leads regardless of
  /// name or insertion order.
  sortOrder   Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches             Batch[]
  squads              Squad[]
  students            Student[]
  mentors             MentorCampus[]
  assignments         Assignment[]
  assignmentsOriginal Assignment[]               @relation("AssignmentOriginalCampus")
  dailyStatuses       DailyStatus[]
  leaderboardEntries  LeaderboardEntry[]
  emailReports        EmailReport[]
  baselineTests       BaselineTest[]
  baselineAttempts    BaselineTestAttempt[]
  movementsFrom       StudentCampusHistory[]     @relation("CampusMovedFrom")
  movementsTo         StudentCampusHistory[]     @relation("CampusMovedTo")
  audienceChangesFrom AssignmentAudienceChange[] @relation("AssignmentAudienceCampusFrom")
  audienceChangesTo   AssignmentAudienceChange[] @relation("AssignmentAudienceCampusTo")

  @@index([status])
  @@index([sortOrder])
  @@map("campuses")
}

/// Which campuses a mentor may see.
///
/// Authorization, not presentation. `Squad.mentorId` already records who runs a squad, but
/// nothing ever read it to decide what a mentor could fetch — every MENTOR could list every
/// student at every campus. Campus is the level the programme is actually organised at, so
/// it is the level access is granted at.
///
/// A mentor with no rows here sees no students. That is the correct failure direction for
/// an access rule, and it is why the migration that introduces this table grants every
/// existing mentor every existing campus: the rule arrives enforcing exactly today's
/// behaviour, and narrowing it is a deliberate admin action rather than a side effect of a
/// deploy. ADMIN is never consulted — admins are unrestricted by definition.
model MentorCampus {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @db.Uuid
  campusId String @db.Uuid

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  /// One grant per mentor per campus — re-granting is idempotent rather than duplicated.
  @@unique([userId, campusId])
  @@index([userId])
  @@index([campusId])
  @@map("mentor_campuses")
}

/// A batch is a first-class organisational unit, not a label on a student, and it is
/// **campus-scoped**: `VELS/A` and `SRM/A` are two different batches that happen to
/// share a code and a name.
///
/// That scoping is deliberate (§8). One global "Foundation" row shared by every campus
/// would make `Assignment.batchId` ambiguous — an assignment targeting Foundation could
/// not say *which campus's* Foundation it meant, and a campus filter would have to be
/// re-derived from the students rather than read from the row. Every batch therefore
/// belongs to exactly one campus, and `campusId` is `NOT NULL`.
///
/// `code` is unique *per campus*, not globally, for the same reason. Batches are looked
/// up by `(campus, code)` at the edges (URLs, CSV columns, filter chips) and carried as
/// `batchId` everywhere else, so adding a level — or a campus — is rows in these two
/// tables plus nothing else.
///
/// A batch owns its own assignments: two batches can have entirely different problem
/// sets on the same day, and a student is only ever evaluated against the set belonging
/// to the batch *they were in on that day* (see `DailyStatus.batchId`).
model Batch {
  id          String      @id @default(uuid()) @db.Uuid
  /// The campus this batch belongs to. Required: a batch with no campus could not be
  /// filtered, targeted or reported on without guessing.
  campusId    String      @db.Uuid
  /// Human-readable, e.g. "Foundation Level". Unique within a campus, not globally.
  name        String
  /// Short stable key used in URLs, filters and the roster CSV, e.g. "A". Compared
  /// case-insensitively at the edges and stored uppercase. Unique within a campus.
  code        String
  description String?
  status      BatchStatus @default(ACTIVE)
  /// Display order for pickers and reports, so Foundation always precedes Intermediate
  /// regardless of name or insertion order.
  sortOrder   Int         @default(0)

  startDate DateTime?
  endDate   DateTime?
  /// Retained alongside `status` because existing queries and the deploy'd API read it.
  /// `status` is authoritative; this mirrors it for backward compatibility.
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campus                        Campus                     @relation(fields: [campusId], references: [id], onDelete: Restrict)
  students                      Student[]
  squads                        Squad[]
  assignments                   Assignment[]
  assignmentsOriginal           Assignment[]               @relation("AssignmentOriginalBatch")
  dailyStatuses                 DailyStatus[]
  leaderboardEntries            LeaderboardEntry[]
  emailReports                  EmailReport[]
  baselineTests                 BaselineTest[]
  baselineAttempts              BaselineTestAttempt[]
  movementsFrom                 StudentBatchHistory[]      @relation("BatchMovedFrom")
  movementsTo                   StudentBatchHistory[]      @relation("BatchMovedTo")
  assignmentAudienceChangesFrom AssignmentAudienceChange[] @relation("AssignmentAudienceFrom")
  assignmentAudienceChangesTo   AssignmentAudienceChange[] @relation("AssignmentAudienceTo")

  /// Campus-scoped uniqueness — see the model comment. `VELS/A` and `SRM/A` coexist.
  @@unique([campusId, code])
  @@unique([campusId, name])
  @@index([isActive])
  @@index([status])
  @@index([campusId, status, sortOrder])
  @@map("batches")
}

model Squad {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  /// The campus this squad belongs to. Denormalised from `batch.campusId` rather than
  /// derived, because a squad can exist before it has a batch: SRM's squads arrive from
  /// the roster while every student is still awaiting placement, so there is no batch to
  /// read a campus from. Backfilled from the batch for every pre-campus squad.
  campusId String? @db.Uuid
  batchId  String? @db.Uuid
  mentorId String? @db.Uuid
  color    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch    Batch?                  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  campus   Campus?                 @relation(fields: [campusId], references: [id], onDelete: SetNull)
  mentor   User?                   @relation("SquadMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  students Student[]
  entries  SquadLeaderboardEntry[]

  /// Squad names are unique per batch, not globally — "Squad 74" may exist in
  /// several batches, which is exactly how mentors name them in practice.
  ///
  /// Caveat worth knowing: Postgres treats NULLs as distinct, so this constraint
  /// does *not* stop two batch-less squads sharing a name. Every writer
  /// (`StudentImportService`, `prisma/seed-students.ts`) therefore looks a squad up
  /// by `(name, batchId)` before creating one.
  @@unique([batchId, name])
  /// Squad numbers are reused across campuses (SRM has "Squad 83", Vels has "Squad 8"),
  /// so squad identity is campus-scoped too. Batch-less squads — SRM's, until placement
  /// happens — are looked up by `(campusId, name)`; the constraint above cannot cover
  /// them because Postgres treats NULL `batch_id` values as distinct.
  @@unique([campusId, name])
  @@index([mentorId])
  @@index([campusId])
  @@map("squads")
}

model Student {
  id                  String        @id @default(uuid()) @db.Uuid
  name                String
  /// Institutional email, and the identity the importer keys on when it is known.
  ///
  /// Nullable because a roster can arrive without it, and a student who exists in the
  /// programme must exist in the system — an unknown email is a missing *field*, not a
  /// missing person. It is never invented: the conventions in use are inconsistent
  /// (`first.last.s.NNN`, `first.initial.sNN`, `last.first.sNN`), so a derived address
  /// would be wrong often enough to create students who cannot log in and who the later
  /// correct import duplicates rather than updates.
  ///
  /// Still `@unique`: Postgres permits many NULLs under a unique index, so this keeps
  /// real addresses distinct while letting unknown ones coexist. A student with no email
  /// simply has no portal login until one is supplied.
  email               String?       @unique
  /// Institutional register/roll number, where the roster carries one. A second stable
  /// identity for import matching when email is not yet known.
  registerNumber      String?       @unique
  phone               String?
  /// Stored lowercase; LeetCode usernames are case-insensitive for lookup but the
  /// API echoes back the canonical casing, which we keep in `leetcodeDisplayName`.
  ///
  /// Nullable because roster membership and a linked LeetCode account are genuinely
  /// separate facts: a student can be on the authoritative roster before anyone has
  /// collected their handle. The alternative — inventing a placeholder handle — would
  /// make them permanently indistinguishable from a student whose handle is simply
  /// wrong, and the sync would keep reporting a "user not found" that is not true.
  /// Students with no handle are skipped by the sync and shown as PROFILE_MISSING —
  /// a roster gap an admin closes by entering a handle, not a failed read.
  ///
  /// Postgres treats NULLs as distinct, so the unique index still permits many students
  /// without a handle while forbidding two students sharing one.
  leetcodeUsername    String?       @unique
  leetcodeDisplayName String?
  status              StudentStatus @default(ACTIVE)
  avatarUrl           String?

  /// The campus the student is in *now*. Exactly the same contract as `batchId`
  /// below: historical placement lives in `StudentCampusHistory` and in
  /// `DailyStatus.campusId`, and a past day's campus is never re-derived from this
  /// column. A student transferred from Vels to SRM on 20 Aug still belongs to Vels in
  /// every report about 10 Aug (§17).
  ///
  /// Nullable for the same reason `batchId` is: the column has to exist before every row
  /// has a value, and Prisma cannot add a required foreign key to a populated table
  /// without a default. Every row is backfilled by the campus migration and every write
  /// path sets it, so "no campus" is not a state the application produces.
  campusId String? @db.Uuid

  /// The batch the student is in *now*. Historical placement lives in
  /// `StudentBatchHistory` and in `DailyStatus.batchId` — never re-derive a past day's
  /// batch from this column, which changes whenever a mentor moves someone.
  ///
  /// Invariant: when both are set, `batch.campusId === campusId`. Enforced by every
  /// write path (`BatchesService.moveStudent` rejects a cross-campus batch) rather than
  /// by a database constraint, because Postgres cannot express it without a trigger.
  batchId String? @db.Uuid
  squadId String? @db.Uuid

  /// Cohort within the programme (1…6 today, stored as an integer so ordering and
  /// counting are exact). Not an enum: cohorts are added routinely and a new one must
  /// not require a migration.
  cohort Int?

  /// The authoritative belt level from the roster. Deliberately *stored*, never derived
  /// from score, solved counts, languages or eligibility — those produced a different
  /// number from the one the programme actually awards. The derived belt fields
  /// elsewhere are left intact for future use; this is the one that is displayed.
  maxBeltLevel Int?

  /// Set when the student leaves the current programme (`status = ARCHIVED`). Kept as
  /// separate columns rather than inferred from `status` so "when did they leave and
  /// why" survives a later status change.
  archivedAt     DateTime?
  archivedReason String?

  /// Denormalised aggregates, refreshed after each sync. Always derivable from
  /// `Submission` + `DailyStatus`; cached here so list views need no joins.
  currentStreak Int @default(0)
  longestStreak Int @default(0)
  totalSolved   Int @default(0)
  totalScore    Int @default(0)
  easySolved    Int @default(0)
  mediumSolved  Int @default(0)
  hardSolved    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch            Batch?                 @relation(fields: [batchId], references: [id], onDelete: SetNull)
  campus           Campus?                @relation(fields: [campusId], references: [id], onDelete: SetNull)
  squad            Squad?                 @relation(fields: [squadId], references: [id], onDelete: SetNull)
  campusHistory    StudentCampusHistory[]
  baselineAttempts BaselineTestAttempt[]
  submissions      Submission[]
  dailyStatuses    DailyStatus[]
  syncState        StudentSyncState?
  notes            MentorNote[]
  achievements     StudentAchievement[]
  entries          LeaderboardEntry[]
  notifications    NotificationLog[]
  blockers         Blocker[]
  batchHistory     StudentBatchHistory[]
  /// The student's own login, if one has been provisioned (§ student portal). Optional —
  /// a student can exist on the roster for a long time before anyone provisions their
  /// portal access, exactly like `leetcodeUsername`.
  user             User?

  @@index([squadId])
  @@index([batchId])
  @@index([campusId])
  @@index([status])
  @@index([name])
  @@index([cohort])
  /// The shape of nearly every current-roster query: active students in one batch.
  @@index([status, batchId])
  /// The campus-filtered equivalents. `(status, campusId, batchId)` covers the full
  /// `Campus → Batch` drill-down — global, campus-only and campus+batch all read the
  /// same index, which is what keeps the directory and leaderboards from degrading as a
  /// second campus multiplies the roster (§27).
  @@index([status, campusId])
  @@index([status, campusId, batchId])
  @@map("students")
}

/// Immutable log of every batch placement a student has ever had.
///
/// This is what makes §7 enforceable: a historical report asks "which batch was this
/// student in on 10 Aug?" and gets the answer that was true then, not the answer that
/// is true now. Rows are append-only — moving a student back and forth produces three
/// rows, not one edited row — so the audit trail survives.
///
/// `effectiveFromDayKey` is a program-day string rather than a timestamp because every
/// other day-scoped comparison in the system is (see the schema header): resolving
/// "batch on day D" must be a string comparison against the same keys `DailyStatus`
/// and `Assignment` use, with no timezone maths in the middle.
model StudentBatchHistory {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @db.Uuid

  /// Null for the very first placement (the student came from nowhere) and for a move
  /// out of the pre-batch era.
  fromBatchId String? @db.Uuid
  toBatchId   String? @db.Uuid

  /// The program day this placement takes effect, inclusive. A move recorded today does
  /// not rewrite yesterday.
  effectiveFromDayKey String

  /// Optional but encouraged — the admin UI asks for it on every manual move.
  reason String?
  source BatchChangeSource @default(MANUAL)

  changedById   String? @db.Uuid
  /// Denormalised so the history still reads correctly after a mentor account is deleted.
  changedByName String?

  changedAt DateTime @default(now())

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromBatch Batch?  @relation("BatchMovedFrom", fields: [fromBatchId], references: [id], onDelete: SetNull)
  toBatch   Batch?  @relation("BatchMovedTo", fields: [toBatchId], references: [id], onDelete: SetNull)
  changedBy User?   @relation("BatchChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  /// The resolver's access path: newest placement at or before a given day.
  @@index([studentId, effectiveFromDayKey])
  @@index([toBatchId])
  @@index([changedAt])
  @@map("student_batch_history")
}

/// Immutable log of every campus a student has ever belonged to.
///
/// The campus twin of `StudentBatchHistory`, with the same append-only contract and the
/// same `effectiveFromDayKey` semantics, because it answers the same class of question:
/// "which campus was this student in on 10 Aug?" must keep returning Vels after they
/// transfer to SRM on 20 Aug (§17). Campus transfers are rarer than batch moves, but a
/// rare rewrite of history is still a rewrite.
///
/// Kept as a separate table rather than extra columns on `StudentBatchHistory` because
/// the two events are independent: moving Foundation → Intermediate within one campus
/// must not manufacture a campus-change row, and a campus transfer that keeps the level
/// must not manufacture a batch row that says "moved from Foundation to Foundation".
model StudentCampusHistory {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @db.Uuid

  /// Null for the very first placement — the student came from outside the programme,
  /// or predates campuses entirely.
  fromCampusId String? @db.Uuid
  toCampusId   String? @db.Uuid

  /// The program day this placement takes effect, inclusive.
  effectiveFromDayKey String

  reason String?
  source BatchChangeSource @default(MANUAL)

  changedById   String? @db.Uuid
  /// Denormalised so the history still reads correctly after a mentor account is deleted.
  changedByName String?

  changedAt DateTime @default(now())

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromCampus Campus? @relation("CampusMovedFrom", fields: [fromCampusId], references: [id], onDelete: SetNull)
  toCampus   Campus? @relation("CampusMovedTo", fields: [toCampusId], references: [id], onDelete: SetNull)
  changedBy  User?   @relation("CampusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  /// The resolver's access path: newest placement at or before a given day.
  @@index([studentId, effectiveFromDayKey])
  @@index([toCampusId])
  @@index([changedAt])
  @@map("student_campus_history")
}

// ---------------------------------------------------------------------------
// Problems & assignments
// ---------------------------------------------------------------------------

/// Cached LeetCode problem metadata. Fetched once per problem and refreshed lazily —
/// titles and difficulty effectively never change, acceptance rate drifts slowly.
model Problem {
  id                 String     @id @default(uuid()) @db.Uuid
  titleSlug          String     @unique
  title              String
  /// LeetCode's internal id and the number shown on the site — they differ.
  questionId         String?
  questionFrontendId String?
  difficulty         Difficulty
  acceptanceRate     Float?
  isPaidOnly         Boolean    @default(false)
  topicTags          String[]   @default([])
  /// Empty in practice: company tags are premium-gated and the public GraphQL
  /// endpoint returns null. Kept so a future authenticated provider can fill it.
  companyTags        String[]   @default([])
  url                String
  metadataFetchedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignmentProblems   AssignmentProblem[]
  submissions          Submission[]
  problemStatuses      DailyProblemStatus[]
  baselineTestProblems BaselineTestProblem[]
  baselineResults      BaselineTestProblemResult[]

  @@index([difficulty])
  @@map("problems")
}

/// One day's problem set for one **campus + batch** audience.
///
/// The unique key is `(dayKey, campusId, batchId)`, not `dayKey`: the same calendar date
/// legitimately carries four independent problem sets — Vels/Foundation, Vels/Intermediate,
/// SRM/Foundation, SRM/Intermediate — and a student is evaluated only against the row for
/// the campus and batch *they were in that day*.
///
/// Both scope columns are nullable, and null is a widening, not a gap:
///
///  * `batchId = NULL` — every batch inside `campusId`.
///  * `campusId = NULL` **and** `batchId = NULL` — every student everywhere. This is also
///    exactly what the pre-campus, pre-batch legacy rows mean, which is why they need no
///    retro-stamping: they applied to everybody at the time and they still do.
///
/// `campusId = NULL` with a non-null `batchId` is not a legal combination and is rejected
/// by `AssignmentsService`: a batch already names its campus, so the pair would be able to
/// disagree with itself. Legacy rows that had a batch before campuses existed are backfilled
/// to that batch's campus by the migration, which is not a reinterpretation — Vels was the
/// only campus then, so "Foundation" meant "Vels Foundation" (§38).
///
/// Postgres treats NULLs as distinct in a unique index, so `@@unique([dayKey, campusId,
/// batchId])` alone would still permit two rows for the same widened audience. Partial
/// unique indexes covering each NULL combination close that gap — see the migration.
model Assignment {
  id     String @id @default(uuid()) @db.Uuid
  /// `YYYY-MM-DD` in the program timezone.
  dayKey String

  /// The campus this assignment targets; null means every campus. Always equal to
  /// `batch.campusId` when `batchId` is set.
  campusId String? @db.Uuid
  batchId  String? @db.Uuid

  /// The audience this assignment was created with, frozen forever once set (first write
  /// wins — see the migration). `campusId`/`batchId` are the *current* administrative
  /// target and may be changed later via "Change Assignment Target" (§9); the `original*`
  /// columns are what the UI shows as "originally assigned to" so a retarget is visible
  /// rather than silently rewriting what actually happened. Historical evaluation does not
  /// depend on any of these columns directly — `DailyStatus.assignmentId` is frozen to this
  /// row's id the first time a day is computed, so retargeting never changes what a past day
  /// was scored against (see `RollupService.persistDailyStatus`).
  originalCampusId String? @db.Uuid
  originalBatchId  String? @db.Uuid

  title       String?
  topic       String?
  notes       String?
  /// Overall difficulty label for the day; individual problems carry their own.
  difficulty  Difficulty?
  isPublished Boolean     @default(true)

  createdById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy       User?                      @relation("AssignmentAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  batch           Batch?                     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  campus          Campus?                    @relation(fields: [campusId], references: [id], onDelete: Restrict)
  originalBatch   Batch?                     @relation("AssignmentOriginalBatch", fields: [originalBatchId], references: [id], onDelete: SetNull)
  originalCampus  Campus?                    @relation("AssignmentOriginalCampus", fields: [originalCampusId], references: [id], onDelete: SetNull)
  problems        AssignmentProblem[]
  dailyStatuses   DailyStatus[]
  audienceChanges AssignmentAudienceChange[]

  @@unique([dayKey, campusId, batchId])
  @@index([dayKey])
  @@index([batchId, dayKey])
  /// The daily resolver's access path: one day, narrowed to one campus's rows.
  @@index([campusId, dayKey])
  @@index([campusId, batchId, dayKey])
  @@map("assignments")
}

/// Append-only record of an admin retargeting an assignment's audience (§9) — "this was
/// assigned to All, now target it to Foundation only". Mirrors `StudentBatchHistory`'s
/// shape and purpose: the fact that a change happened, when, by whom and why must survive
/// even though only one `Assignment.batchId` value can be current at a time.
///
/// This table is what makes the retarget *safe*: it never touches `DailyStatus` rows, and
/// changing `Assignment.batchId` cannot retroactively alter a day that has already been
/// scored, because `RollupService` freezes `DailyStatus.assignmentId` the first time a day
/// is computed and never swaps it for a different assignment on a later recompute.
model AssignmentAudienceChange {
  id           String  @id @default(uuid()) @db.Uuid
  assignmentId String  @db.Uuid
  fromCampusId String? @db.Uuid
  toCampusId   String? @db.Uuid
  fromBatchId  String? @db.Uuid
  toBatchId    String? @db.Uuid
  reason       String?

  changedById   String? @db.Uuid
  /// Denormalised so the history still reads correctly after a mentor account is deleted.
  changedByName String?

  changedAt DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  fromBatch  Batch?     @relation("AssignmentAudienceFrom", fields: [fromBatchId], references: [id], onDelete: SetNull)
  toBatch    Batch?     @relation("AssignmentAudienceTo", fields: [toBatchId], references: [id], onDelete: SetNull)
  fromCampus Campus?    @relation("AssignmentAudienceCampusFrom", fields: [fromCampusId], references: [id], onDelete: SetNull)
  toCampus   Campus?    @relation("AssignmentAudienceCampusTo", fields: [toCampusId], references: [id], onDelete: SetNull)
  changedBy  User?      @relation("AssignmentAudienceChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([assignmentId, changedAt])
  @@map("assignment_audience_changes")
}

model AssignmentProblem {
  id           String @id @default(uuid()) @db.Uuid
  assignmentId String @db.Uuid
  problemId    String @db.Uuid
  /// 1-based slot (Problem 1 … Problem 4).
  position     Int

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  problem    Problem    @relation(fields: [problemId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, position])
  @@unique([assignmentId, problemId])
  @@index([problemId])
  @@map("assignment_problems")
}

// ---------------------------------------------------------------------------
// Submission mirror — the system's source of truth
// ---------------------------------------------------------------------------

/// Every submission observed for a student, accepted or not.
///
/// `titleSlug` is denormalised and always present, while `problemId` is optional:
/// students solve far more problems than we assign, and resolving metadata for every
/// one would multiply provider calls for no benefit. We link to `Problem` only when
/// the slug matches something we track.
model Submission {
  id        String  @id @default(uuid()) @db.Uuid
  studentId String  @db.Uuid
  problemId String? @db.Uuid

  /// LeetCode's submission id — the idempotency key for the mirror.
  providerSubmissionId String
  provider             String @default("leetcode")

  titleSlug String
  title     String
  status    ProblemStatus @default(ACCEPTED)
  language  String?
  /// Runtime and memory are not exposed by the public submission-list queries;
  /// nullable so an authenticated provider can populate them later without a migration.
  runtime   String?
  memory    String?

  submittedAt DateTime
  /// Program-day bucket of `submittedAt`, precomputed so day queries never
  /// re-derive timezone maths in SQL.
  dayKey      String

  createdAt DateTime @default(now())

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  problem Problem? @relation(fields: [problemId], references: [id], onDelete: SetNull)

  /// Makes re-running a sync a no-op instead of a duplicate.
  @@unique([studentId, provider, providerSubmissionId])
  @@index([studentId, dayKey])
  @@index([studentId, titleSlug])
  @@index([studentId, submittedAt])
  @@index([titleSlug])
  @@index([dayKey])
  /// Lifetime distinct-solved: COUNT(DISTINCT titleSlug) per student over accepted rows.
  /// Covers the whole aggregate, so it never touches the heap for ~250 students.
  @@index([studentId, status, titleSlug])
  /// Assignment completion over the lookback window: a day-range scan narrowed to the
  /// handful of assigned slugs, for every student at once.
  @@index([dayKey, titleSlug])
  /// Baseline grading: one student's submissions inside a wall-clock test window,
  /// narrowed to the test's slugs. Timestamps rather than `dayKey`, because a test
  /// window is bounded by `opensAt`/`closesAt`, not by a program day.
  @@index([studentId, submittedAt, titleSlug])
  @@map("submissions")
}

/// Per-student sync bookkeeping: the incremental cursor plus why the last attempt
/// looked the way it did.
model StudentSyncState {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @unique @db.Uuid

  /// Newest submission timestamp already mirrored. The incremental sync stops
  /// walking the provider's list once it reaches this point.
  lastSubmissionAt         DateTime?
  lastProviderSubmissionId String?
  lastSyncedAt             DateTime?
  lastSuccessAt            DateTime?
  status                   SyncStatus @default(NEVER_SYNCED)
  lastError                String?
  consecutiveFailures      Int        @default(0)
  totalSyncs               Int        @default(0)
  /// Cached from the provider's aggregate stats — the student's all-time totals.
  ///
  /// This is the *authoritative* lifetime solved count. The submission mirror can only
  /// ever be a floor: LeetCode exposes the 20 most recent submissions, so anything a
  /// student solved before we first synced them is unobservable. `Student.totalSolved`
  /// reconciles the two (see `StudentMetricsService.lifetimeSolvedByStudent`), which is
  /// only correct as long as these columns are actually kept up to date.
  providerTotalSolved      Int?
  providerEasySolved       Int?
  providerMediumSolved     Int?
  providerHardSolved       Int?
  providerRanking          Int?
  /// When the profile stats above were last fetched. Drives the refresh cadence in
  /// `StudentSyncService` — profile totals move slowly, so they are re-read far less
  /// often than submissions rather than on every sync cycle.
  providerProfileFetchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([lastSyncedAt])
  /// Created by the `track_provider_profile_freshness` migration; declared here so the
  /// schema and the database agree. Drives "whose profile totals are stale".
  @@index([providerProfileFetchedAt])
  @@map("student_sync_states")
}

// ---------------------------------------------------------------------------
// Derived daily state
// ---------------------------------------------------------------------------

/// One row per student per program day. A rebuildable cache — recomputing it from
/// the submission mirror is always safe.
model DailyStatus {
  id           String  @id @default(uuid()) @db.Uuid
  studentId    String  @db.Uuid
  dayKey       String
  assignmentId String? @db.Uuid

  /// The campus and batch this student was in *on this day* — historical facts, frozen.
  ///
  /// These columns are the reason a batch move or a campus transfer cannot rewrite the
  /// past. The rollup writes each only when it is still null (see
  /// `RollupService.persistDailyStatus`); once set neither is updated, so recomputing
  /// 10 Aug after a 15 Aug move still reports 10 Aug under the campus and batch the
  /// student was actually in. Null on rows written before campuses/batches existed,
  /// which is why scoped history is explicit about the pre-campus era rather than
  /// silently attributing it to a campus that did not exist yet.
  campusId String? @db.Uuid
  batchId  String? @db.Uuid

  assignedCount Int @default(0)
  solvedCount   Int @default(0)

  score          Int   @default(0)
  /// Labelled `ScoreComponent[]`, so the UI can explain a score without recomputing it.
  scoreBreakdown Json?

  /// When the student finished the *whole* assignment; null if they did not.
  completedAt      DateTime?
  /// Minute-of-day of `completedAt` in program time — the leaderboard tiebreaker.
  completionMinute Int?
  firstSolvedAt    DateTime?
  lastSolvedAt     DateTime?

  isPerfect      Boolean    @default(false)
  streakAtDay    Int        @default(0)
  syncStatus     SyncStatus @default(NEVER_SYNCED)
  /// Set when a mentor overrides the automatic result.
  isOverridden   Boolean    @default(false)
  overrideNote   String?
  overriddenById String?    @db.Uuid

  computedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student         Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignment      Assignment?          @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  batch           Batch?               @relation(fields: [batchId], references: [id], onDelete: SetNull)
  campus          Campus?              @relation(fields: [campusId], references: [id], onDelete: SetNull)
  problemStatuses DailyProblemStatus[]

  @@unique([studentId, dayKey])
  @@index([dayKey])
  @@index([dayKey, solvedCount])
  @@index([studentId])
  @@index([dayKey, score])
  /// The daily tracker's query: one day, one batch, bucketed by solved count.
  @@index([dayKey, batchId])
  /// The campus-scoped equivalents — one day narrowed to a campus, or to a campus+batch.
  @@index([dayKey, campusId])
  @@index([dayKey, campusId, batchId])
  /// "When was this day last computed?" — how a sync discovers that an assignment was
  /// entered after its own date and the day was never re-evaluated. Descending so the
  /// planner takes the newest row per day and stops instead of aggregating the whole day.
  @@index([dayKey, computedAt(sort: Desc)])
  @@map("daily_statuses")
}

/// Per-problem outcome within a day. Denormalised from `Submission` so the mentor
/// dashboard's five tables — including "which questions are missing" — are a single
/// indexed read rather than 250 × 4 correlated lookups.
model DailyProblemStatus {
  id            String        @id @default(uuid()) @db.Uuid
  dailyStatusId String        @db.Uuid
  problemId     String        @db.Uuid
  position      Int
  status        ProblemStatus @default(NOT_ATTEMPTED)
  solvedAt      DateTime?
  language      String?
  runtime       String?
  memory        String?
  attempts      Int           @default(0)

  dailyStatus DailyStatus @relation(fields: [dailyStatusId], references: [id], onDelete: Cascade)
  problem     Problem     @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([dailyStatusId, problemId])
  @@index([problemId])
  @@index([status])
  @@map("daily_problem_statuses")
}

// ---------------------------------------------------------------------------
// Leaderboards (materialised snapshots)
// ---------------------------------------------------------------------------

/// Snapshots rather than live queries: ranks must be stable for a given period so
/// "you moved up 3 places" is meaningful, and so a leaderboard can be shown instantly
/// without recomputing 250 students' scores on every page load.
model LeaderboardEntry {
  id        String            @id @default(uuid()) @db.Uuid
  period    LeaderboardPeriod
  /// `2026-08-04`, `2026-W32`, `2026-08`, or `ALL` depending on `period`.
  periodKey String
  studentId String            @db.Uuid

  /// The campus and batch the student was ranked *as part of* when this snapshot was
  /// built. Snapshotted rather than joined through `Student.campusId`/`batchId` so a
  /// later move leaves past leaderboards historically correct — the point of
  /// materialising ranks in the first place.
  campusId String? @db.Uuid
  batchId  String? @db.Uuid

  /// The student's rank across **every** campus for this period.
  ///
  /// Stored beside `rank` rather than derived from it, because neither can produce the
  /// other: interleaving per-campus positions is not the same ordering as ranking every
  /// student together, and a global list cannot be read as a campus list without
  /// re-numbering it (§14). Both are computed from the same underlying scores in
  /// `RollupService.buildLeaderboard`, which is what lets a Vels student and an SRM
  /// student sit at #1 and #2 globally while each also leads their own campus.
  ///
  /// Nullable only for snapshots written before campuses existed; the migration
  /// backfills those from `rank`, which was a global rank at the time.
  globalRank Int?

  /// The student's rank **within their own campus** for this period.
  ///
  /// Batch-level ranks are deliberately not stored: a third column would have to be
  /// recomputed whenever anyone moved batch, and the leaderboard service can re-rank a
  /// campus's snapshot rows in memory far more cheaply than the schema can keep a third
  /// materialised ordering honest.
  rank             Int
  previousRank     Int?
  score            Int     @default(0)
  solvedCount      Int     @default(0)
  currentStreak    Int     @default(0)
  completionMinute Int?
  consistency      Float   @default(0)
  isTied           Boolean @default(false)

  computedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  campus  Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@unique([period, periodKey, studentId])
  @@index([period, periodKey, rank])
  @@index([studentId])
  @@index([period, periodKey, batchId, rank])
  /// The three leaderboard scopes read three indexes: global (`globalRank`),
  /// campus (`campusId, rank`) and campus+batch (`campusId, batchId, rank`).
  @@index([period, periodKey, globalRank])
  @@index([period, periodKey, campusId, rank])
  @@index([period, periodKey, campusId, batchId, rank])
  @@map("leaderboard_entries")
}

model SquadLeaderboardEntry {
  id        String            @id @default(uuid()) @db.Uuid
  period    LeaderboardPeriod
  periodKey String
  squadId   String            @db.Uuid

  rank              Int
  previousRank      Int?
  memberCount       Int     @default(0)
  averageCompletion Float   @default(0)
  totalSolved       Int     @default(0)
  averageStreak     Float   @default(0)
  averageScore      Float   @default(0)
  isTied            Boolean @default(false)

  computedAt DateTime @default(now())

  squad Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)

  @@unique([period, periodKey, squadId])
  @@index([period, periodKey, rank])
  @@map("squad_leaderboard_entries")
}

// ---------------------------------------------------------------------------
// Scoring configuration
// ---------------------------------------------------------------------------

/// The scoring formula as data. Exactly one row is active; older rows are retained
/// so a recomputation can be explained ("scored under formula v3").
model ScoringConfig {
  id       String  @id @default(uuid()) @db.Uuid
  version  Int     @unique @default(autoincrement())
  name     String
  isActive Boolean @default(false)

  /// Full `ScoringConfig` shape from @dsa/shared. Stored as JSON because the formula's
  /// structure (bonus tiers) is itself editable — columns would force a migration
  /// every time an admin added a tier.
  config Json

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@map("scoring_configs")
}

// ---------------------------------------------------------------------------
// Sync engine
// ---------------------------------------------------------------------------

model SyncJob {
  id      String        @id @default(uuid()) @db.Uuid
  status  SyncJobStatus @default(QUEUED)
  mode    SyncMode      @default(INCREMENTAL)
  trigger SyncTrigger   @default(MANUAL)
  dayKey  String?

  totalStudents     Int @default(0)
  processedStudents Int @default(0)
  succeededStudents Int @default(0)
  failedStudents    Int @default(0)
  /// Students the run deliberately did not attempt, because no LeetCode handle is
  /// linked to them. Counted apart from `failedStudents` so a roster gap never marks a
  /// healthy run as COMPLETED_WITH_ERRORS.
  skippedStudents   Int @default(0)
  newSubmissions    Int @default(0)

  startedAt   DateTime?
  finishedAt  DateTime?
  durationMs  Int?
  error       String?
  /// Per-student failure detail, so "retry failed" knows exactly what to retry.
  errorDetail Json?

  triggeredById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  triggeredBy User?         @relation(fields: [triggeredById], references: [id], onDelete: SetNull)
  items       SyncJobItem[]

  @@index([status])
  @@index([createdAt])
  @@index([dayKey])
  @@map("sync_jobs")
}

model SyncJobItem {
  id             String     @id @default(uuid()) @db.Uuid
  syncJobId      String     @db.Uuid
  studentId      String     @db.Uuid
  status         SyncStatus @default(NEVER_SYNCED)
  newSubmissions Int        @default(0)
  attempts       Int        @default(0)
  error          String?
  durationMs     Int?
  processedAt    DateTime?

  createdAt DateTime @default(now())

  syncJob SyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@unique([syncJobId, studentId])
  @@index([syncJobId, status])
  @@map("sync_job_items")
}

// ---------------------------------------------------------------------------
// Gamification
// ---------------------------------------------------------------------------

/// Achievement *rules* live in code (`@dsa/shared`); this table records only when a
/// student first unlocked one, which is the part that cannot be recomputed.
model StudentAchievement {
  id         String    @id @default(uuid()) @db.Uuid
  studentId  String    @db.Uuid
  code       String
  unlockedAt DateTime  @default(now())
  notifiedAt DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, code])
  @@index([code])
  @@map("student_achievements")
}

// ---------------------------------------------------------------------------
// Mentor workflow, auditing, notifications, settings
// ---------------------------------------------------------------------------

model MentorNote {
  id        String  @id @default(uuid()) @db.Uuid
  studentId String  @db.Uuid
  authorId  String? @db.Uuid
  body      String
  /// Private notes are visible only to their author and admins.
  isPrivate Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@map("mentor_notes")
}

model AuditLog {
  id         String  @id @default(uuid()) @db.Uuid
  actorId    String? @db.Uuid
  actorName  String?
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model SystemLog {
  id       String   @id @default(uuid()) @db.Uuid
  level    LogLevel @default(INFO)
  context  String
  message  String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([level])
  @@index([context])
  @@index([createdAt])
  @@map("system_logs")
}

/// Channel configuration for the notification abstraction. No transport is shipped
/// enabled by default — the architecture is in place, credentials are not.
model NotificationChannelConfig {
  id        String              @id @default(uuid()) @db.Uuid
  channel   NotificationChannel @unique
  isEnabled Boolean             @default(false)
  /// Webhook URLs, API tokens, sender addresses — shape varies per channel.
  config    Json?
  events    NotificationEvent[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_channel_configs")
}

model NotificationLog {
  id        String              @id @default(uuid()) @db.Uuid
  channel   NotificationChannel
  event     NotificationEvent
  status    NotificationStatus  @default(PENDING)
  studentId String?             @db.Uuid
  recipient String?
  payload   Json?
  error     String?
  sentAt    DateTime?

  createdAt DateTime @default(now())

  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([channel, status])
  @@index([createdAt])
  @@map("notification_logs")
}

/// Free-form application settings (program timezone, sync schedule, feature flags).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Daily email reporting & follow-up
// ---------------------------------------------------------------------------
//
// There is deliberately no `DailyReport` table. Every number a report shows — problems
// assigned, who solved what, completion buckets — is reconstructable at any time from
// `Assignment` + `DailyStatus` + `DailyProblemStatus` for the requested `dayKey`
// (see `DailyEmailReportService`), exactly like the rest of the app's aggregates. Only
// the two facts that cannot be recomputed are persisted here: what a mentor recorded
// about a blocker, and what an approved email actually said when it was sent.

/// A mentor's record of why a student did not finish a day's assignment, plus what was
/// done about it. One row per student per day — a second submission for the same day
/// updates the existing row rather than creating a duplicate.
model Blocker {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @db.Uuid
  /// `YYYY-MM-DD` in the program timezone — the same key `DailyStatus` uses.
  dayKey    String

  /// Snapshot of the student's outcome at the time this was recorded, so the entry
  /// reads correctly even if a later sync changes `DailyStatus.solvedCount`.
  solvedCount   Int
  assignedCount Int

  category    BlockerCategory @default(NO_BLOCKER)
  description String?
  actionTaken String?

  followUpRequired Boolean   @default(false)
  /// `YYYY-MM-DD`; optional even when `followUpRequired` is true.
  followUpDate     String?
  mentorNotes      String?
  resolvedAt       DateTime?

  recordedById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("BlockerRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([studentId, dayKey])
  @@index([dayKey])
  @@index([studentId])
  @@map("blockers")
}

/// One generated daily report email, tracked through DRAFT → PENDING_APPROVAL →
/// APPROVED → SENT (or FAILED). Rows are never mutated after `SENT` — the whole point
/// of persisting `subjectFinal`/`bodyHtml` is that "View Previous Email" shows exactly
/// what went out, even after later syncs change the underlying data. This table *is*
/// the email history (§14): no separate log table.
model EmailReport {
  id     String            @id @default(uuid()) @db.Uuid
  dayKey String
  status EmailReportStatus @default(DRAFT)

  /// Which campus and batch this report covers. Null widens, exactly as it does on
  /// `Assignment`: `batchId = NULL` is every batch in the campus, and both null is the
  /// all-campuses report. A day can therefore have an SRM/Foundation report, a
  /// Vels/Foundation report, a per-campus roll-up and a global one side by side, each
  /// tracked through its own approval lifecycle and each carrying only its own scope's
  /// numbers (§33).
  campusId String? @db.Uuid
  batchId  String? @db.Uuid

  fromEmail    String
  toRecipients String[]
  ccRecipients String[] @default([])

  subject  String
  bodyHtml String

  /// The computed report (summary, buckets, action items, blocker counts) at the time
  /// this email was generated — the source the HTML/CSV were rendered from. Kept so a
  /// sent email's numbers can be explained without re-deriving them later.
  snapshot Json

  generatedById String?  @db.Uuid
  generatedAt   DateTime @default(now())

  approvedById String?   @db.Uuid
  approvedAt   DateTime?

  sentAt            DateTime?
  providerMessageId String?
  failedError       String?

  /// Set when this row was created via "Send Again" after a prior SENT report for the
  /// same day, so the history can show the chain instead of two unrelated rows.
  supersedesId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generatedBy User?   @relation("EmailReportGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  approvedBy  User?   @relation("EmailReportApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  batch       Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  campus      Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@index([dayKey])
  @@index([status])
  @@index([dayKey, status])
  @@index([dayKey, batchId, status])
  @@index([dayKey, campusId, batchId, status])
  @@map("email_reports")
}

// ---------------------------------------------------------------------------
// Baseline tests
// ---------------------------------------------------------------------------
//
// Baseline tests are a *separate feature* from daily assignments, and the separation is
// structural rather than a convention someone has to remember (§25, §39).
//
// The two answer different questions. A daily assignment measures practice and
// consistency: it feeds `DailyStatus`, the streak, the daily score and every leaderboard
// built on them. A baseline test measures independent capability at a point in time —
// whether a student can solve something unaided — and must not move any of those numbers.
// If a baseline result could raise a completion percentage or extend a streak, the two
// signals would contaminate each other and neither would mean what it says.
//
// So baseline data lives in its own tables with its own scoring, and *nothing* below
// writes to `DailyStatus`, `Submission` aggregates, `Student.currentStreak`,
// `Student.totalScore` or `LeaderboardEntry`. The one thing it shares is the submission
// mirror it reads from: grading a baseline attempt is a query over `Submission` rows in
// the test window, so the existing LeetCode sync remains the single ingestion path and
// no parallel provider integration exists to drift out of step.

/// Lifecycle of one baseline test.
///
/// `DRAFT` is editable and invisible to students. `SCHEDULED` is published — students can
/// see that it is coming and its problems are frozen — but it has not opened. `ACTIVE`
/// means attempts may be started and graded. `CLOSED` is terminal for participation: the
/// report is final, and no new attempt can begin. Re-grading a closed test is still
/// allowed, because a late LeetCode sync can legitimately fill in a submission that was
/// made before the close time.
enum BaselineTestStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  CLOSED
}

/// Where one student is in one baseline test.
///
/// `NOT_STARTED` is never stored — a student who has not started has no attempt row at
/// all, and the report derives "not started" from the eligible roster minus the attempts.
/// It exists in the enum so the reporting layer has one vocabulary for all three states.
enum BaselineAttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

/// Whether a mentor has looked at an attempt's risk signals yet.
///
/// Deliberately not a verdict about the student. The system never concludes that anyone
/// cheated; it says "review recommended" and shows the evidence that prompted it (§23).
/// `REVIEW_REQUIRED` is set automatically when signals fire; `REVIEWED` is only ever set
/// by a human, together with the note explaining what they concluded.
enum BaselineReviewStatus {
  NOT_REVIEWED
  REVIEW_REQUIRED
  REVIEWED
}

/// One observable, evidence-backed pattern in an attempt — never an accusation.
///
/// Every value here is something the submission mirror can actually demonstrate with a
/// timestamp. There is deliberately no "PLAGIARISM" or "CHEATED" member: the public
/// LeetCode API exposes no submitted source, so any similarity claim would be invented.
/// If an authenticated provider ever supplies code, a `CODE_SIMILARITY` member can be
/// added here alongside the evidence that supports it.
enum BaselineRiskSignal {
  /// Accepted within seconds of the test opening — faster than reading the problem.
  IMMEDIATE_ACCEPTANCE
  /// Several problems accepted within an implausibly short window of each other.
  RAPID_SUCCESSION
  /// Accepted on the first submission for every problem, with no failed attempt.
  NO_FAILED_ATTEMPTS
  /// Solved far faster than this student's own historical pace on comparable problems.
  INCONSISTENT_WITH_HISTORY
  /// An accepted submission for a test problem exists from *before* the test opened.
  SOLVED_BEFORE_TEST
}

/// One weekly baseline test, targeted at a campus + batch audience.
///
/// Scope resolution is identical to `Assignment`'s and for the same reason: null widens.
/// `campusId = NULL` means every campus, `batchId = NULL` means every batch inside the
/// campus, and a non-null `batchId` always implies its own campus. Eligibility is
/// evaluated against the campus and batch a student was in *on `dayKey`*, not their
/// current ones, so a transfer mid-programme cannot retroactively add or remove someone
/// from a test they did or did not sit.
model BaselineTest {
  id     String @id @default(uuid()) @db.Uuid
  /// Mentor-facing name, e.g. "Baseline Test #3".
  name   String
  /// `YYYY-MM-DD` in the program timezone — the day the test belongs to.
  dayKey String

  description  String?
  /// Shown to students on the start screen. Never contains answer keys or mentor notes;
  /// everything students must not see lives on the attempt or in `adminNotes`.
  instructions String?
  /// Mentor-only. Explicitly excluded from every student-facing projection (§22).
  adminNotes   String?

  campusId String? @db.Uuid
  batchId  String? @db.Uuid

  /// Wall-clock window. `opensAt`/`closesAt` bound which submissions can count towards
  /// the test; `durationMinutes` bounds one student's individual attempt from the moment
  /// they start it. A student who starts late gets their full duration but is still cut
  /// off at `closesAt`.
  durationMinutes Int       @default(60)
  opensAt         DateTime?
  closesAt        DateTime?

  status BaselineTestStatus @default(DRAFT)

  createdById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User?                 @relation("BaselineTestAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  campus    Campus?               @relation(fields: [campusId], references: [id], onDelete: Restrict)
  batch     Batch?                @relation(fields: [batchId], references: [id], onDelete: Restrict)
  problems  BaselineTestProblem[]
  attempts  BaselineTestAttempt[]

  @@index([dayKey])
  @@index([status])
  @@index([campusId, batchId, dayKey])
  @@index([status, dayKey])
  @@map("baseline_tests")
}

/// One problem inside a baseline test, with its own weight.
///
/// `points` is per problem rather than a flat per-test score because a test deliberately
/// mixes difficulties ("2 Easy, 2 Medium") and a Medium should not be worth the same as
/// an Easy. `difficulty` is denormalised from `Problem` so a report can bucket by
/// difficulty without joining, and so the weighting a test was built with survives even
/// if LeetCode later reclassifies the problem.
model BaselineTestProblem {
  id        String @id @default(uuid()) @db.Uuid
  testId    String @db.Uuid
  problemId String @db.Uuid
  /// 1-based slot.
  position  Int
  points    Int    @default(10)

  difficulty Difficulty

  test    BaselineTest                @relation(fields: [testId], references: [id], onDelete: Cascade)
  problem Problem                     @relation(fields: [problemId], references: [id], onDelete: Restrict)
  results BaselineTestProblemResult[]

  @@unique([testId, position])
  @@unique([testId, problemId])
  @@index([problemId])
  @@map("baseline_test_problems")
}

/// One student's participation in one baseline test.
///
/// `campusId`/`batchId` are frozen at start, exactly like `DailyStatus`'s: the report for
/// a past test keeps grouping a student under the campus and batch they sat it in, even
/// after a transfer (§17).
///
/// Scores here are never added to `Student.totalScore`, never counted towards a streak,
/// and never written into `LeaderboardEntry` — see the section header. `score` is only
/// ever meaningful inside baseline reporting.
model BaselineTestAttempt {
  id        String @id @default(uuid()) @db.Uuid
  testId    String @db.Uuid
  studentId String @db.Uuid

  /// Frozen audience context — the campus and batch the student was in when they sat it.
  campusId String? @db.Uuid
  batchId  String? @db.Uuid

  status BaselineAttemptStatus @default(IN_PROGRESS)

  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  /// When the individual window closes: `startedAt + durationMinutes`, clamped to the
  /// test's `closesAt`. Stored rather than recomputed so a later change to the test's
  /// duration cannot retroactively shorten or extend an attempt already under way.
  expiresAt   DateTime?

  solvedCount      Int  @default(0)
  attemptedCount   Int  @default(0)
  score            Int  @default(0)
  maxScore         Int  @default(0)
  /// Seconds from `startedAt` to the last accepted submission, or to submission/expiry
  /// when nothing was solved.
  timeTakenSeconds Int?

  /// Evidence-backed patterns observed during grading. Empty is the normal case.
  /// Mentor/admin-visible only — never projected into any student-facing response (§23).
  riskFlags    BaselineRiskSignal[] @default([])
  /// 0–100, derived from `riskFlags` and their severity. A triage ordering for mentors,
  /// not a judgement about the student, and likewise never shown to students.
  riskScore    Int                  @default(0)
  reviewStatus BaselineReviewStatus @default(NOT_REVIEWED)
  /// What the reviewing mentor concluded. Mentor-only.
  reviewNote   String?
  reviewedById String?              @db.Uuid
  reviewedAt   DateTime?

  gradedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  test       BaselineTest                @relation(fields: [testId], references: [id], onDelete: Cascade)
  student    Student                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  campus     Campus?                     @relation(fields: [campusId], references: [id], onDelete: SetNull)
  batch      Batch?                      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  reviewedBy User?                       @relation("BaselineAttemptReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  results    BaselineTestProblemResult[]

  /// One attempt per student per test — re-starting resumes rather than duplicating.
  @@unique([testId, studentId])
  @@index([testId, status])
  @@index([studentId])
  @@index([testId, campusId, batchId])
  @@index([testId, reviewStatus])
  @@map("baseline_test_attempts")
}

/// Per-problem outcome inside one attempt, derived from the submission mirror.
///
/// `ATTEMPTED_NOT_ACCEPTED` and `NOT_ATTEMPTED` stay distinct here for the same reason
/// they do in `DailyProblemStatus`: a mentor reads "tried and failed" very differently
/// from "never opened it", and a baseline report that collapsed them would hide exactly
/// the students who need help most.
model BaselineTestProblemResult {
  id            String @id @default(uuid()) @db.Uuid
  attemptId     String @db.Uuid
  testProblemId String @db.Uuid
  problemId     String @db.Uuid

  status   ProblemStatus @default(NOT_ATTEMPTED)
  attempts Int           @default(0)
  points   Int           @default(0)

  firstSubmissionAt  DateTime?
  solvedAt           DateTime?
  /// Seconds from the attempt's `startedAt` to `solvedAt`. The input to the
  /// `IMMEDIATE_ACCEPTANCE` and `RAPID_SUCCESSION` signals.
  timeToSolveSeconds Int?
  language           String?

  attempt     BaselineTestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  testProblem BaselineTestProblem @relation(fields: [testProblemId], references: [id], onDelete: Cascade)
  problem     Problem             @relation(fields: [problemId], references: [id], onDelete: Restrict)

  @@unique([attemptId, testProblemId])
  @@index([problemId])
  @@index([status])
  @@map("baseline_test_problem_results")
}
