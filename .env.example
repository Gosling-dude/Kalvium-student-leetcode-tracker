# ---------------------------------------------------------------------------
# DSA Tracker — environment template.
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database ---------------------------------------------------------------
# Docker Compose provides this host/port/credentials out of the box.
# For a local Postgres install, substitute your own role and password.
DATABASE_URL=postgresql://dsa:dsa_password@localhost:5432/dsa_tracker?schema=public

# --- Redis / queue ----------------------------------------------------------
# QUEUE_DRIVER=bullmq requires Redis. Use `inline` to run syncs in-process
# without Redis — useful for local development and small deployments, but it
# gives up cross-process concurrency and durability across restarts.
QUEUE_DRIVER=bullmq
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=dsa

# --- Cache ------------------------------------------------------------------
# When Redis is unavailable the app falls back to an in-memory LRU cache
# automatically; no configuration change is required.
CACHE_ENABLED=true

# --- API --------------------------------------------------------------------
# PORT is read from the environment. On managed hosts (e.g. Render) the platform
# injects it — do NOT set PORT there, or the app will bind the wrong port and the
# host will report "no open ports detected".
PORT=4000
API_PREFIX=api/v1
# Comma-separated list of allowed browser origins. In production set this to the
# deployed frontend URL, e.g. https://dsa-web.onrender.com
CORS_ORIGINS=http://localhost:3000
# Serve Swagger UI at ${API_PREFIX}/docs. Defaults off in production.
SWAGGER_ENABLED=true

# --- Auth -------------------------------------------------------------------
# MUST be changed for any deployment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# Seeded administrator. Change the password before seeding anything real.
SEED_ADMIN_EMAIL=admin@kalvium.com
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_NAME=Program Admin

# Demo cohort (60 fake students + 30 days of synthetic history). Seeded only outside
# production so the dashboard has something to show locally. It is force-disabled when
# NODE_ENV=production; set SEED_DEMO=false to also skip it in development.
SEED_DEMO=true

# --- Program rules ----------------------------------------------------------
# Every day boundary in the app — streaks, "today", completion times — is
# resolved in this timezone. Changing it re-buckets historical reports.
PROGRAM_TIMEZONE=Asia/Kolkata
PROBLEMS_PER_DAY=4

# --- Sync scheduling --------------------------------------------------------
# These drive the IN-PROCESS scheduler. Cron expressions are evaluated in
# PROGRAM_TIMEZONE.
#
# IMPORTANT: LeetCode's public submission list returns only the 20 most recent
# entries, so a once-a-day sync can permanently miss submissions from students
# who solve many problems. Sync several times a day.
#
# On Render this work runs as dedicated cron jobs (see render.yaml) instead, so the
# web service sets SYNC_ENABLED=false to avoid running each sync twice.
SYNC_CRON=0 */3 * * *
SYNC_ENABLED=true
# Nightly recompute of leaderboards and streaks, after the day has closed.
ROLLUP_CRON=30 0 * * *

# --- Provider (LeetCode) ----------------------------------------------------
LEETCODE_GRAPHQL_ENDPOINT=https://leetcode.com/graphql
PROVIDER_REQUESTS_PER_SECOND=4
PROVIDER_CONCURRENCY=5
PROVIDER_MAX_RETRIES=4
PROVIDER_TIMEOUT_MS=15000
# Optional: an authenticated session cookie unlocks richer submission detail
# (runtime/memory). Entirely optional — the app works fully without it.
LEETCODE_SESSION_COOKIE=
LEETCODE_CSRF_TOKEN=

# --- Rate limiting ----------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true
PERSIST_LOGS=true

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=DSA Tracker
